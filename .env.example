# ==============================================================================
# JECRC University Portal — Production Environment Variables Template
# ==============================================================================
# NOTE: Do NOT commit production values. Populate these variables in your
# deployment platform (e.g., Railway / Render / AWS ECS / Vercel).
# ==============================================================================

# --- PostgreSQL Database Configuration ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<managed-postgres-host>:<port>/<database-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# --- Spring Active Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Security & JWT Token Signing ---
# Provide a cryptographically secure 256-bit (or 512-bit) random string
JWT_SECRET=generate_a_random_64_character_hex_or_base64_secret_key_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Cookie & CORS Configuration ---
# Production cookie domain (leave empty or set to root domain if cross-subdomain)
COOKIE_DOMAIN=
# Comma-separated list of trusted frontend origins
CORS_ALLOWED_ORIGINS=https://portal.jecrcuniversity.edu.in,https://jecrc-portal.vercel.app

# --- Initial Super Administrator Bootstrap ---
APP_ADMIN_EMAIL=admin@jecrcuniversity.edu.in
APP_ADMIN_PASSWORD=your_strong_production_admin_password_here

# --- Demo & Synthetic Data Guard ---
# MUST BE FALSE IN PRODUCTION
APP_SEED_DEMO_USERS=false
APP_DEMO_PASSWORD=

# --- Frontend (Vercel) Same-Origin Proxy Architecture ---
# Note: The browser interacts exclusively with the same-origin frontend at /api/v1/...
# The Vercel frontend proxies all /api/* traffic directly to the Java backend via `frontend/vercel.json` rewrites:
# {
#   "source": "/api/:path*",
#   "destination": "https://<your-backend-railway-app>.up.railway.app/api/:path*"
# }
# This guarantees that HttpOnly refresh cookies, CSRF protection, and session rotation operate
# seamlessly within the same origin without requiring cross-origin cookie sharing.
